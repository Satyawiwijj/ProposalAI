// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProposalStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
}

enum ExportFormat {
  PDF
  WORD
  LINK
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  avatarUrl     String?
  passwordHash  String?
  role          String    @default("user")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  proposals     Proposal[]
  templates     Template[]
  settings      UserSettings?
  activityLogs  ActivityLog[]

  @@map("users")
}

model Client {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  company   String?
  phone     String?
  address   String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  proposals Proposal[]

  @@map("clients")
}

model Proposal {
  id                  String        @id @default(cuid())
  title               String
  status              ProposalStatus @default(DRAFT)
  timeline            String
  pricing             Decimal       @db.Decimal(12, 2)
  pricingBreakdown    Json
  terms               String?
  numberingScheme     String?
  proposalNumber      String?       @unique
  sentAt              DateTime?
  viewedAt            DateTime?
  acceptedAt          DateTime?
  rejectedAt          DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  userId              String
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  clientId            String?
  client              Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)

  scopeItems          ProposalScopeItem[]
  exports             Export[]
  activityLogs        ActivityLog[]

  @@index([userId])
  @@index([status])
  @@index([clientId])
  @@map("proposals")
}

model ProposalScopeItem {
  id          String   @id @default(cuid())
  title       String
  description String
  confidence  String?  // high, medium, low
  order       Int      @default(0)
  hours       Decimal? @db.Decimal(6, 2)
  rate        Decimal? @db.Decimal(8, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  proposalId  String
  proposal    Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
  @@map("proposal_scope_items")
}

model Template {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String   // consulting, software, marketing, design
  scopeItems  Json     // array of {title, description, confidence, hours, rate}
  pricing     Json     // {baseRate, complexityMultiplier, timeline}
  usageCount  Int      @default(0)
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([userId])
  @@map("templates")
}

model Export {
  id        String       @id @default(cuid())
  format    ExportFormat
  fileUrl   String?
  fileName  String?
  expiresAt DateTime?
  createdAt DateTime     @default(now())

  proposalId String
  proposal  Proposal     @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
  @@map("exports")
}

model ActivityLog {
  id        String   @id @default(cuid())
  action    String   // created, edited, exported, sent, viewed, accepted, rejected
  metadata  Json?
  createdAt DateTime @default(now())

  proposalId String
  proposal  Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([proposalId])
  @@index([userId])
  @@index([action])
  @@map("activity_logs")
}

model UserSettings {
  id                    String   @id @default(cuid())
  userId                String   @unique

  // General
  companyName           String?
  website               String?
  contactEmail          String?
  defaultCurrency       String   @default("USD")
  timezone              String   @default("UTC")
  dateFormat            String   @default("MM/DD/YYYY")

  // Proposals
  defaultTimeline       String   @default("2 weeks")
  hourlyRate            Decimal  @default(150) @db.Decimal(8, 2)
  complexityMultiplier  Decimal  @default(1.35) @db.Decimal(4, 2)
  numberingScheme       String   @default("PROP-{YEAR}-{SEQ}")
  defaultTerms          String?

  // Email
  emailProvider         String?  // resend, sendgrid, smtp
  emailApiKey           String?
  emailFromAddress      String?
  emailFromName         String?

  // Notifications
  notifyProposalViewed  Boolean  @default(true)
  notifyProposalAccepted Boolean  @default(true)
  notifyProposalRejected Boolean @default(false)
  notifyWeeklyDigest    Boolean  @default(false)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  source    String?  // reddit, linkedin, demo, direct
  createdAt DateTime @default(now())

  @@index([source])
  @@map("waitlist_entries")
}