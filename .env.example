# Copy this file to .env.local and fill in your keys.
# NEVER commit .env.local — it is gitignored.

DATABASE_URL=
# Vercel KV for rate limiting
KV_REST_API_URL=
KV_REST_API_TOKEN=


# ------------------------------------------------------------------
# AI provider for the proposal extraction endpoint (/api/ai/extract)
# ------------------------------------------------------------------
# Default: NVIDIA (free tier, no credit card — get a key at
# https://build.nvidia.com/settings/api-keys). To use OpenAI instead,
# set AI_PROVIDER=openai and add OPENAI_API_KEY.

# NVIDIA (free, ~40 requests/min, ~1000 credits on signup)
NVIDIA_API_KEY=

# OpenAI (paid) — only needed if AI_PROVIDER=openai
OPENAI_API_KEY=

# Which provider to use: "nvidia" (default) or "openai"
# AI_PROVIDER=nvidia

# Optional overrides
# AI_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# AI_BASE_URL=https://integrate.api.nvidia.com/v1
# AI_THINKING=true   # enable model reasoning (slower, higher quality)

# Optional: email provider keys for the Export → "Send via email" flow
RESEND_API_KEY=
SENDGRID_API_KEY=